{
  "name": "local-project-manager",
  "version": "0.1.0",
  "description": "A local-first control panel for configuring, starting, stopping, and observing development projects.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @lpm/server --filter @lpm/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @lpm/web test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=24"
  }
}
